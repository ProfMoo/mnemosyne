{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Go: Lint",
            "type": "process",
            "command": "make",
            "args": ["lint"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$go",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Go: Format",
            "type": "process",
            "command": "make",
            "args": ["fmt"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
