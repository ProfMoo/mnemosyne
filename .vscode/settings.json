{
    "css.validate": true,
    "files.watcherExclude": {
        "**/bin/web/**": true
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "[sql]": {
        "editor.defaultFormatter": "sqlfluff.vscode-sqlfluff",
        "editor.formatOnSave": true
    },
    "sqlfluff.config": "${workspaceFolder}/.sqlfluff",
    "sqlfluff.executablePath": "/Users/drmoo/.local/share/mise/shims/sqlfluff",
    "sqlfluff.format.enabled": true,
    "sqlfluff.linter.run": "onSave",
    "mise.configureExtensionsAutomatically": true,
    "mise.configureExtensionsAutomaticallyIncludeList": [
        "golang.go"
    ],
    "mise.configureExtensionsIncludeGlobalTools": false,
    "cSpell.words": [
        "brainz",
        "scrobbling",
        "scrobbles",
        "scrobble",
        "scrobbler",
    ],
    "go.alternateTools": {
        "go": "/Users/drmoo/.local/share/mise/shims/go",
        "dlv": "/Users/drmoo/.local/share/mise/shims/dlv",
        "customFormatter": "/Users/drmoo/.local/share/mise/shims/go",
        "gopls": "/Users/drmoo/.local/share/mise/shims/gopls"
    },
    "go.lintOnSave": "off",
    "go.formatTool": "custom",
    "go.formatFlags": [
        "tool",
        "golangci-lint",
        "fmt",
        "--stdin",
        "--config=${workspaceFolder}/.golangci.yaml"
    ],
}
